# Base de datos (Postgres en Easypanel)
DATABASE_URL=                    # ej: postgresql://usuario:clave@adan-db:5432/adan

# IA (obligatoria para el bot)
ANTHROPIC_API_KEY=

# Panel del dueño (/admin)
ADMIN_PASSWORD=                  # la contraseña que usa el dueño
ADMIN_SECRET=                    # texto largo al azar para firmar la sesión

# Fotos subidas desde el panel. En Easypanel, montar un volumen en /app/data
UPLOAD_DIR=/app/data/uploads

# WhatsApp con la API oficial de Meta (recomendado). Si están cargadas, se usa esta y no Evolution.
# Salen de developers.facebook.com > tu app > WhatsApp > Configuración de la API.
WHATSAPP_TOKEN=                  # token de acceso permanente (usuario del sistema en Meta Business)
WHATSAPP_PHONE_NUMBER_ID=        # "Identificador del número de teléfono"
WHATSAPP_APP_SECRET=             # Configuración de la app > Básica > Clave secreta de la app
WHATSAPP_VERIFY_TOKEN=           # texto al azar; se pega en Meta junto con la URL <PUBLIC_SITE_URL>/api/whatsapp
WHATSAPP_OWNER_TEMPLATE=         # opcional: plantilla aprobada con {{1}} para avisar al dueño fuera de las 24 h
WHATSAPP_OWNER_TEMPLATE_LANG=es_AR
# Solo si se usa un proveedor como Kapso en vez de Meta directo:
WHATSAPP_GRAPH_URL=              # ej: https://api.kapso.ai/meta/whatsapp
WHATSAPP_GRAPH_VERSION=          # ej: v24.0 (vacío = v26.0)

# WhatsApp con Evolution API (alternativa no oficial)
WHATSAPP_WEBHOOK_TOKEN=          # clave larga al azar; el webhook es /api/whatsapp?token=<esta clave>
EVOLUTION_URL=                   # ej: https://evo.midominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=adan
OWNER_WHATSAPP=                  # número del dueño para avisos, ej: 5493431234567
PUBLIC_SITE_URL=                 # URL pública de la web, para mandar las fotos

# Mercado Pago (Checkout Pro). Vacío = el link de pago lo manda el dueño por WhatsApp.
# Las credenciales salen de mercadopago.com.ar/developers > Tus integraciones > Credenciales de producción.
MP_ACCESS_TOKEN=                 # APP_USR-...
MP_WEBHOOK_SECRET=               # "Clave secreta" de Webhooks (opcional pero recomendada). URL: <PUBLIC_SITE_URL>/api/mercadopago

# Demo: "1" muestra el asistente de prueba y el aviso de pagos simulados. En la tienda real, vacío.
NEXT_PUBLIC_DEMO_BOT=
